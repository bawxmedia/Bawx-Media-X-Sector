<script>
const SCREENS = {
  1:  { name: "Splash",                       section: "Onboarding" },
  2:  { name: "Welcome carousel",             section: "Onboarding" },
  3:  { name: "Sign up",                      section: "Onboarding" },
  4:  { name: "OTP verification",             section: "Onboarding" },
  5:  { name: "Name capture",                 section: "Onboarding" },
  6:  { name: "Profile photo",                section: "Onboarding" },
  7:  { name: "Permissions",                  section: "Onboarding" },
  8:  { name: "NFC pairing",                  section: "Onboarding" },
  9:  { name: "Activation success",           section: "Onboarding" },
  10: { name: "First card setup",             section: "Onboarding" },
};

let current = 1;

function showScreen(n) {
  // nav items
  document.querySelectorAll('.nav-item').forEach((el, i) => {
    el.classList.toggle('active', i + 1 === n);
  });

  // content panels
  document.querySelectorAll('.screen-content').forEach(el => el.style.display = 'none');
  const panel = document.getElementById('content-' + n);
  if (panel) { panel.style.display = 'block'; }

  // phone wireframes
  document.querySelectorAll('.wf').forEach(el => el.classList.remove('active'));
  const wf = document.querySelector('.wf-' + n);
  if (wf) { wf.classList.add('active'); }

  // pips
  document.querySelectorAll('.scr-pip').forEach((el, i) => {
    el.classList.toggle('active', i + 1 === n);
  });

  // labels
  const info = SCREENS[n];
  document.getElementById('wf-label').textContent = 'Screen ' + String(n).padStart(2, '0');
  document.getElementById('screen-name-top').textContent = info.name;

  // scroll content to top
  document.getElementById('content-area').scrollTop = 0;

  current = n;
  return false;
}

// keyboard navigation
document.addEventListener('keydown', e => {
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
    if (current < 10) showScreen(current + 1);
  } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
    if (current > 1) showScreen(current - 1);
  }
});
</script>
