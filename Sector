  color: #fff;
  font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
  font-weight: 600; font-family: 'JetBrains Mono', monospace;
  padding: 4px 10px; border-radius: 20px;
  opacity: 0.5;
}
</style>
</head>

